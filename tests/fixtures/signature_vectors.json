  "description_rotation": "While a store rotates its secret, Emporiqa signs every emporiqa-to-plugin request with both: t=<t>,v1=<new>,v1=<old>. A receiver holding EITHER secret must accept the header (any v1 matching is enough, compared in constant time), and must refuse it when no v1 matches, when it carries more than 3 v1 values, when any v1 is malformed, or when t is repeated. verify_with lists the secrets each case is checked with; expect is 'ok' or 'signature'.",
  "rotation_vectors": [
    {
      "case": "new then old, receiver holds the new secret",
      "label": "emporiqa-to-plugin",
      "store_id": "st_7Kq2mXa9",
      "t": 1767225600,
      "body": "{\"rule\":\"order_status\",\"request_id\":\"r-1\",\"fields\":{\"order_number\":\"KHWLILZLL\",\"email\":\"pub@prestashop.com\"}}",
      "secrets": [
        "rotated-secret-fedcba9876543210fedcba9876543210",
        "test-secret-0123456789abcdef0123456789abcdef"
      ],
      "verify_with": [
        "rotated-secret-fedcba9876543210fedcba9876543210"
      ],
      "expect": "ok",
      "header": "t=1767225600,v1=ad5dc347c0b87c03be3a1d225156f6a67defa7f1ef0f291aa2ad9be372205fd4,v1=b7e6ddc78238088ff518d1f1d7466c60de9fb2ea60b584bb4a573c6e89221592"
    },
    {
      "case": "new then old, receiver still holds the old secret",
      "label": "emporiqa-to-plugin",
      "store_id": "st_7Kq2mXa9",
      "t": 1767225600,
      "body": "{\"rule\":\"order_status\",\"request_id\":\"r-1\",\"fields\":{\"order_number\":\"KHWLILZLL\",\"email\":\"pub@prestashop.com\"}}",
      "secrets": [
        "rotated-secret-fedcba9876543210fedcba9876543210",
        "test-secret-0123456789abcdef0123456789abcdef"
      ],
      "verify_with": [
        "test-secret-0123456789abcdef0123456789abcdef"
      ],
      "expect": "ok",
      "header": "t=1767225600,v1=ad5dc347c0b87c03be3a1d225156f6a67defa7f1ef0f291aa2ad9be372205fd4,v1=b7e6ddc78238088ff518d1f1d7466c60de9fb2ea60b584bb4a573c6e89221592"
    },
    {
      "case": "old then new, either secret",
      "label": "emporiqa-to-plugin",
      "store_id": "st_7Kq2mXa9",
      "t": 1767225600,
      "body": "{\"rule\":\"order_status\",\"request_id\":\"r-1\",\"fields\":{\"order_number\":\"KHWLILZLL\",\"email\":\"pub@prestashop.com\"}}",
      "secrets": [
        "test-secret-0123456789abcdef0123456789abcdef",
        "rotated-secret-fedcba9876543210fedcba9876543210"
      ],
      "verify_with": [
        "rotated-secret-fedcba9876543210fedcba9876543210",
