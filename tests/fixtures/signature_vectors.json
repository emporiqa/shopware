      ],
      "expect": "ok",
      "header": "t=1767225600,v1=b7e6ddc78238088ff518d1f1d7466c60de9fb2ea60b584bb4a573c6e89221592,v1=ad5dc347c0b87c03be3a1d225156f6a67defa7f1ef0f291aa2ad9be372205fd4"
    },
    {
      "case": "two v1, neither from the receiver's secret",
      "label": "emporiqa-to-plugin",
      "store_id": "st_7Kq2mXa9",
      "t": 1767225600,
      "body": "{\"rule\":\"order_status\",\"request_id\":\"r-1\",\"fields\":{\"order_number\":\"KHWLILZLL\",\"email\":\"pub@prestashop.com\"}}",
