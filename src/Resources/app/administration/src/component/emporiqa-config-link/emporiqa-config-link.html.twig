{% block emporiqa_config_link %}
<div class="emporiqa-config-link">
    <p
        v-if="loaded && connected"
        class="emporiqa-config-link__text"
    >
        <strong>{{ $t('emporiqa-integration.configLink.connected', { storeId }) }}</strong>
        {{ $t('emporiqa-integration.configLink.manage') }}
    </p>
    <p
        v-else-if="loaded"
        class="emporiqa-config-link__text"
    >
        <strong>{{ $t('emporiqa-integration.configLink.notConnected') }}</strong>
        {{ $t('emporiqa-integration.configLink.description') }}
    </p>
    <sw-button
        variant="primary"
        size="small"
        @click="openSettings"
    >
        {{ $t('emporiqa-integration.configLink.button') }}
    </sw-button>
</div>
{% endblock %}
